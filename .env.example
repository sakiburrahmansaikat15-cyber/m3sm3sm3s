# ── Database (cPanel → MySQL Databases) ─────────────────────────────
# mysql://USER:PASSWORD@HOST:3306/DATABASE   (URL-encode special chars in the password)
DATABASE_URL=mysql://m3s_user:change-me@localhost:3306/m3s_store

# ── Admin auth ──────────────────────────────────────────────────────
# Long random string (32+ chars). Changing it logs every admin out.
AUTH_SECRET=replace-with-a-long-random-string

# ── Uploads ─────────────────────────────────────────────────────────
# Folder where GLB / SVG / images are stored (outside the build).
UPLOAD_DIR=./uploads
# Max upload size in MB
UPLOAD_MAX_MB=60
